# UPS REST base (no trailing slash). CIE example:
# https://wwwcie.ups.com/api
# Production: https://onlinetools.ups.com/api
UPS_API_BASE_URL=https://wwwcie.ups.com/api

# OAuth client-credentials token URL (full URL). CIE example:
# https://wwwcie.ups.com/security/v1/oauth/token
UPS_OAUTH_TOKEN_URL=https://wwwcie.ups.com/security/v1/oauth/token

UPS_CLIENT_ID=your_client_id
UPS_CLIENT_SECRET=your_client_secret

# Used in BillShipper / ShipperNumber when your flow requires an account number (may be empty for some published-rate tests).
UPS_ACCOUNT_NUMBER=

# Rating API path version segment (see UPS Rating OpenAPI).
UPS_RATING_VERSION=v2409

# Outbound HTTP timeout (ms).
REQUEST_TIMEOUT_MS=30000

# Refresh the token this many ms before OAuth expires_in elapses.
TOKEN_SKEW_MS=60000
